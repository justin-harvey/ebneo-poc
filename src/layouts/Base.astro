---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const { title, description } = Astro.props;
const fullTitle = title ? `${title} · EBNEO` : 'EBNEO · Evidence-Based Neonatology';
const desc = description ??
  'The International Society for Evidence-Based Neonatology (EBNEO): appraising the best available evidence to improve care for newborn infants.';
const ogImage = new URL('/img/ebneo-logo.png', Astro.site).href;
const siteUrl = (Astro.site?.href ?? 'https://ebneo.org/').replace(/\/$/, '');

// Site-wide structured data: who EBNEO is (MedicalOrganization) + the site + its search action.
// Facts are already public on the site; no new data is introduced. Per-commentary ScholarlyArticle
// is a separate, future enhancement (roadmap M9).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'MedicalOrganization', 'NGO'],
      '@id': `${siteUrl}/#organization`,
      name: 'International Society for Evidence-Based Neonatology',
      alternateName: 'EBNEO',
      url: `${siteUrl}/`,
      logo: ogImage,
      foundingDate: '2015',
      nonprofitStatus: 'Nonprofit501c3',
      identifier: { '@type': 'PropertyValue', propertyID: 'SE-OrgNr', value: '802493-2538' },
      sameAs: [
        'https://x.com/EBNEO',
        'https://bsky.app/profile/ebneo.bsky.social',
        'https://www.youtube.com/c/evidencebasedneonatology',
        'https://www.instagram.com/evidencebasedneo',
        'https://www.facebook.com/ebneo',
        'https://www.linkedin.com/company/evidence-based-neonatology-ebneo/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'EBNEO, Evidence-Based Neonatology',
      publisher: { '@id': `${siteUrl}/#organization` },
      inLanguage: 'en',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/reviews/?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="icon" type="image/png" href="/favicon.png" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0070c0" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <link rel="alternate" type="application/rss+xml" title="EBNEO commentaries" href="/rss.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <SiteHeader />
  <main id="main" class="wrap">
    <slot />
  </main>
  <SiteFooter />
</body>
</html>
