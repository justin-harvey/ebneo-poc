---
import Icon from './Icon.astro';
const { name, role, aff, img, x, linkedin } = Astro.props;
const initials = name.split(/\s+/).slice(0, 2).map((w: string) => w[0]).join('').toUpperCase();
---
<article class="person">
  <div class="av">
    {img
      ? <img src={img} alt={`Portrait of ${name}`} loading="lazy" width="96" height="96" />
      : <span aria-hidden="true">{initials}</span>}
  </div>
  <h3>{name}</h3>
  <p class="role">{role}</p>
  <p class="aff">{aff}</p>
  {(x || linkedin) && (
    <p class="social">
      {x && (
        <a class="x" href={`https://x.com/${x}`} rel="noopener" aria-label={`${name} on X`}>
          <Icon name="twitter" />@{x}
        </a>
      )}
      {linkedin && (
        <a class="linkedin" href={`https://www.linkedin.com/in/${linkedin}`} rel="noopener" aria-label={`${name} on LinkedIn`}>
          <Icon name="linkedin" />LinkedIn
        </a>
      )}
    </p>
  )}
</article>
