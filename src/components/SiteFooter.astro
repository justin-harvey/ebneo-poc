---
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="site">
  <div class="wrap">
    <div class="fcols">
      <div class="fbrand">
        <a class="brand" href="/" aria-label="EBNEO, Evidence-Based Neonatology, home">
          <img class="fmark" src="/img/ebneo-mark.png" width="196" height="196" alt="" aria-hidden="true" />
          <span class="name">EBNEO<small>Evidence-Based Neonatology</small></span>
        </a>
        <p>The International Society for Evidence-Based Neonatology, shortening the path from
          research to the newborn's bedside.</p>
      </div>
      <nav class="fnav" aria-label="Footer">
        <h2>Explore</h2>
        <a href="/about/">About</a>
        <a href="/reviews/">Reviews</a>
        <a href="/vote/">Vote</a>
        <a href="/impact/">Article of the Year</a>
        <a href="/authors/">For authors</a>
        <a href="/contact/">Contact</a>
      </nav>
      <div class="fmeta">
        <h2>The society</h2>
        <p>Registered non-profit in Sweden.<br />Org. number 802493-2538.</p>
        <nav class="fsocial" aria-label="EBNEO on social media">
          <a href="https://x.com/EBNEO" rel="noopener" aria-label="EBNEO on X"><Icon name="twitter" label="X" /></a>
          <a href="https://bsky.app/profile/ebneo.bsky.social" rel="noopener" aria-label="EBNEO on Bluesky"><Icon name="bluesky" label="Bluesky" /></a>
          <a href="https://www.linkedin.com/company/evidence-based-neonatology-ebneo/" rel="noopener" aria-label="EBNEO on LinkedIn"><Icon name="linkedin" label="LinkedIn" /></a>
          <a href="https://www.youtube.com/c/evidencebasedneonatology" rel="noopener" aria-label="EBNEO on YouTube"><Icon name="youtube" label="YouTube" /></a>
          <a href="https://www.instagram.com/evidencebasedneo" rel="noopener" aria-label="EBNEO on Instagram"><Icon name="instagram" label="Instagram" /></a>
          <a href="https://www.facebook.com/ebneo" rel="noopener" aria-label="EBNEO on Facebook"><Icon name="facebook" label="Facebook" /></a>
        </nav>
        <a class="flink" href="https://www.paypal.com/donate/" rel="noopener"><Icon name="heart" />Support our work</a>
      </div>
    </div>
    <div class="frow">
      <small>&copy; {year} EBNEO · International Society for Evidence-Based Neonatology</small>
      <small>Neonatal care, firmly based on the best available evidence.</small>
    </div>
  </div>
</footer>
