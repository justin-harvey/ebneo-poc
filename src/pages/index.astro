---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getCollection } from 'astro:content';

const commentaries = (await getCollection('commentaries')).filter(
  (c) => c.data.status !== 'draft'
);
const total = commentaries.length;

// Newest-first teaser so the home page offers easy navigation to recent commentaries.
const latest = commentaries
  .map((c) => ({
    title: c.data.title,
    slug: c.slug,
    investigation: (c.data.investigation || '').trim(),
    year: c.data.publish_date ? new Date(c.data.publish_date).getUTCFullYear() : null,
    date: c.data.publish_date ? +new Date(c.data.publish_date) : 0,
  }))
  .sort((a, b) => b.date - a.date)
  .slice(0, 4);
---
<Base>
  <section class="panel">
    <div class="hero">
      <!-- Brand "vital signs" motif, echoing the logo ECG trace -->
      <svg class="pulse" viewBox="0 0 240 60" fill="none" aria-hidden="true">
        <path d="M0 40 H60 L72 40 L84 14 L100 52 L112 26 L124 26 L132 8 L144 40 H240"
          stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="badge">International Society · Founded 2015</span>
      <h1>Neonatal care, firmly based on the best available evidence.</h1>
      <p class="lede">The International Society for Evidence-Based Neonatology (EBNEO) shortens the
        path from research to the bedside, improving survival, reducing morbidity, and promoting
        lifelong health for newborn infants. EBNEO is a registered non-profit in Sweden.</p>
      <div class="facts">
        <div class="fact"><Icon name="award2" /><b>2015</b><span>Society founded</span></div>
        <div class="fact"><Icon name="users" /><b>20+</b><span>Board &amp; editors worldwide</span></div>
        <div class="fact"><Icon name="activity" /><b>{total}+</b><span>Commentaries on this site</span></div>
        <div class="fact"><Icon name="globe" /><b>10+</b><span>Countries represented</span></div>
      </div>
    </div>

    <h2 class="section"><Icon name="activity" />Latest commentaries</h2>
    <p class="section-sub">The most recent evidence appraisals published on this site.</p>
    <div class="grid reviews">
      {latest.map((c) => <ReviewCard {...c} />)}
    </div>
    <p style="margin:14px 0 0;display:flex;flex-wrap:wrap;gap:10px">
      <a class="btn" href="/reviews/"><Icon name="file" />Browse all {total} reviews</a>
      <a class="btn" href="/rss.xml"><Icon name="activity" />RSS feed</a>
    </p>

    <h2 class="section"><Icon name="award2" />Our goals</h2>
    <p class="section-sub">What the society works toward, every month.</p>
    <div class="grid goals">
      <div class="goal"><Icon name="globe" /><p>Provide an international forum to communicate and support evidence-based medicine for neonatal care in a global context.</p></div>
      <div class="goal"><Icon name="search" /><p>Provide an interactive forum for the critical evaluation of the literature.</p></div>
      <div class="goal"><Icon name="activity" /><p>Give neonatal care-givers the best available knowledge by widening the dissemination of evidence-based neonatology.</p></div>
      <div class="goal"><Icon name="check" /><p>Facilitate research on diagnostic procedures and interventions for important clinical outcomes.</p></div>
    </div>

    <h2 class="section"><Icon name="users" />Led by an international board</h2>
    <p class="section-sub">Neonatologists and researchers from more than ten countries guide the
      society's evidence mission.</p>
    <div class="box">
      <p style="margin-bottom:0;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
        <a class="btn" href="/team/"><Icon name="users" />Meet the Executive Board &amp; founders</a>
      </p>
    </div>
  </section>
</Base>
