---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = (await getCollection('commentaries')).filter((c) => c.data.status !== 'draft');
  return items.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const dateObj = d.publish_date ? new Date(d.publish_date) : null;
const date = dateObj
  ? dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : null;
const year = dateObj ? dateObj.getUTCFullYear() : null;
// Pagefind meta read off the archive results (full-text search is built in M4a).
const meta = [
  d.investigation && `investigation:${d.investigation}`,
  year && `year:${year}`,
  date && `date:${date}`,
].filter(Boolean).join(', ');
---
<Base title={d.title.replace(/^EBNEO\s+Commentary:?\s*/i, '')}>
  <section class="panel">
    <p class="breadcrumb"><a href="/reviews/">← All reviews</a></p>
    <article class="article" data-pagefind-body
      data-pagefind-filter={d.investigation ? `investigation:${d.investigation}` : undefined}
      data-pagefind-sort={dateObj ? `date:${dateObj.toISOString().slice(0, 10)}` : undefined}
      data-pagefind-meta={meta || undefined}>
      {year && <span data-pagefind-filter={`year:${year}`} hidden></span>}
      <h1>{d.title}</h1>
      <p class="byline">
        {date && <span>{date}</span>}
        {d.investigation && <span class="tag">{d.investigation}</span>}
        {d.pmid && <span>· PMID <a href={`https://pubmed.ncbi.nlm.nih.gov/${d.pmid}/`} rel="noopener">{d.pmid}</a></span>}
        {d.doi && <span>· DOI {d.doi}</span>}
      </p>
      <Content />
      <p style="margin-top:32px">
        <a class="btn" href="/reviews/"><Icon name="file" /> Back to all reviews</a>
      </p>
    </article>
  </section>
</Base>
